  "keywords": ["image", "rendering", "fastify", "piscina", "server"],
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://gitee.com/gabinlin/render-server"
  },
  "bugs": {
    "url": "https://gitee.com/gabinlin/render-server/issues"
  },
