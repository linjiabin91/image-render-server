{
  "name": "@render-server/benchmark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "benchmark": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "benchmark": "node dist/index.js",
    "test": "pnpm benchmark --body ~/req/farbic.json",
    "farbic_big_png": "pnpm benchmark --body ~/req/farbic_big_png.json -c 50 -a 600",
    "farbic_big_jpg": "pnpm benchmark --body ~/req/farbic_big_jpg.json -c 50 -a 600",
    "farbic_small_png": "pnpm benchmark --body ~/req/farbic_small_png.json -c 100 -a 600",
    "farbic_small_jpg": "pnpm benchmark --body ~/req/farbic_small_jpg.json -c 100 -a 600",
    "leafer_big_png": "pnpm benchmark --body ~/req/leafer_big_png.json -c 50 -a 300"
  },
  "dependencies": {
    "autocannon": "^8.0.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.0.0",
    "@types/node": "^25.9.2"
  }
}