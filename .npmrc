# pnpm 默认严格模式 —— 只提升直接依赖，孙依赖不暴露。
# 但 fabric/leafer 内部运行时会访问孙依赖（如 jsdom 内部 require('canvas')），
# 严格模式下找不到这些包会报错。npm 平铺结构下无此问题。
#
# shamefully-hoist=true 让 pnpm 退化为 npm 的平铺行为，把所有依赖（包括孙子级）
# 都提升到根 node_modules，保证 fabric/leafer/konva 运行时能访问到它们需要的包。
#
# 更好的方案是手动声明缺失的孙依赖，但因为 canvas 被 pnpm.overrides 替换为
# @napi-rs/canvas，手动声明会导致版本冲突，所以 hoist 是目前最省事的做法。
shamefully-hoist=true
