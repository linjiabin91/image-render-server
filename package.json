{
  "name": "render-server",
  "license": "MIT",
  "type": "module",
  "description": "Multi-engine image rendering server supporting Leafer, Fabric.js, Konva, and Playwright",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://gitee.com/gabinlin/render-server"
  },
  "bugs": {
    "url": "https://gitee.com/gabinlin/render-server/issues"
  },
  "homepage": "https://gitee.com/gabinlin/render-server",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm install && tsc -b packages/core packages/server packages/leafer-engine packages/fabric5-engine packages/fabric-engine packages/playwright-engine packages/konva-engine",
    "lint": "eslint packages/",
    "lint:fix": "eslint packages/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "LOG_PRETTY=true node packages/leafer-engine/dist/server.js",
    "start:konva": "LOG_PRETTY=true node packages/konva-engine/dist/server.js",
    "start:fabric": "LOG_PRETTY=true node packages/fabric-engine/dist/server.js",
    "start:fabric5": "LOG_PRETTY=true node packages/fabric5-engine/dist/server.js",
    "start:playwright": "LOG_PRETTY=true node packages/playwright-engine/dist/server.js",
    "benchmark": "LOG_PRETTY=true node packages/benchmark/dist/index.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.4",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@8.4.0",
  "pnpm": {
    "overrides": {
      "canvas": "@napi-rs/canvas"
    }
  }
}
