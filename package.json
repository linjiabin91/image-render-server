    "start:konva": "node packages/konva-engine/dist/server.js",
    "benchmark": "node packages/benchmark/dist/index.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.4",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "packageManager": "pnpm@8.4.0",
  "pnpm": {
    "overrides": {
      "canvas": "@napi-rs/canvas"
    }
  }
