{
  "name": "render-server",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -b packages/core packages/server packages/leafer-engine packages/fabric5-engine packages/fabric-engine packages/playwright-engine packages/konva-engine",
    "lint": "eslint packages/",
